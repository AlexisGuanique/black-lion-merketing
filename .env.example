# En Windows, si el servidor no detecta cambios de archivos, descomenta:
# WATCHPACK_POLLING=true

# URL del widget de reservas (Calendly, GoHighLevel, etc.)
NEXT_PUBLIC_CALENDLY_URL=

# Endpoint del formulario de contacto (opcional)
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Número de WhatsApp para el flujo de compra (formato internacional sin + ni espacios)
NEXT_PUBLIC_WHATSAPP_NUMBER=13213144332

# Square Payment Links — una URL por servicio (obligatorio para checkout directo)
# Crear en Square Dashboard > Items > Payment Links
NEXT_PUBLIC_SQUARE_LINK_SOCIAL_MEDIA_AUDIT=
NEXT_PUBLIC_SQUARE_LINK_MARKETING_CONSULTATION=
NEXT_PUBLIC_SQUARE_LINK_SOCIAL_MEDIA_SETUP=
NEXT_PUBLIC_SQUARE_LINK_BRAND_POSITIONING=
NEXT_PUBLIC_SQUARE_LINK_MARKETING_STRATEGY_BLUEPRINT=
NEXT_PUBLIC_SQUARE_LINK_WEBSITE_DEVELOPMENT_SEO=
NEXT_PUBLIC_SQUARE_LINK_RUSH_CONTENT_DELIVERY=
NEXT_PUBLIC_SQUARE_LINK_SOCIAL_MEDIA_CONTENT_PACKAGE=
NEXT_PUBLIC_SQUARE_LINK_MARKETING_GROWTH_PACKAGE=
NEXT_PUBLIC_SQUARE_LINK_PREMIUM_BRAND_LAUNCH=
